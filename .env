# ============================================================
# LE RÊVE PROPERTIES — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in real values.
# ============================================================

# ---------- Core ----------
FLASK_ENV=development
SECRET_KEY=change-me-to-a-64-char-random-string
FLASK_DEBUG=true

PAYSTACK_CALLBACK_URL=http://localhost:5007/paystack/callback

# ---------- Site ----------
SITE_NAME=Le Rêve Properties
SITE_URL=https://lereve-properties.com
#PUBLIC_SITE_URL=https://lereve-properties.com
PUBLIC_SITE_URL=http://localhost:5007
PORT=5007

# ---------- MongoDB ----------
MONGO_URI=mongodb://162.35.183.139:27017/lereve_properties
MONGO_DB_NAME=lereve_properties
MONGO_CONNECT_TIMEOUT_MS=5000

# ---------- Paystack (GHS) ----------
PAYSTACK_SECRET_KEY=sk_test_c45dabd81218e4fac598659fc1368c1dd76e3b26
PAYSTACK_PUBLIC_KEY=pk_test_4caf27ba085782664d98466d38b07ec4d334426a
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=https://lereve-properties.com/paystack/callback

# ---------- Mail (Gmail) ----------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=concierge@lereveproperties.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=concierge@lereveproperties.com

# ---------- Super Admin (created on first boot) ----------
SUPER_ADMIN_EMAIL=admin@lereveproperties.com
SUPER_ADMIN_PASSWORD=change-me-immediately
SUPER_ADMIN_NAME=Super Admin

# ---------- Currency ----------
DEFAULT_CURRENCY=GHS
DEFAULT_CURRENCY_SYMBOL=₵

# ---------- Pagination ----------
ITEMS_PER_PAGE=12
ADMIN_PAGE_SIZE=20

# ---------- Rate Limiting ----------
RATELIMIT_ENABLED=true

# ---------- Logging ----------
LOG_LEVEL=INFO

# ---------- Analytics tracking secret (for public site → our /api/track) ----------
ANALYTICS_TRACK_SECRET=change-me-to-a-long-random-string